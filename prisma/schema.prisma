// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum TournamentStatus {
  SETUP // cargando jugadores
  PAIRS_DONE // parejas sorteadas, falta elegir formato y armar zonas/cuadro
  GROUP_STAGE // fase de grupos en juego (solo formato GROUPS_KO)
  IN_PROGRESS // cuadro de eliminacion armado, jugandose
  FINISHED // hay un campeon
}

enum TournamentFormat {
  SINGLE_ELIMINATION // eliminacion directa desde el sorteo de parejas
  GROUPS_KO // fase de grupos (zonas) y luego eliminacion directa con los clasificados
}

enum PairingMode {
  DRAW // las parejas se sortearon al azar
  MANUAL // el organizador las formo a mano
}

model Tournament {
  id                 String           @id @default(cuid())
  name               String
  status             TournamentStatus @default(SETUP)
  format             TournamentFormat @default(SINGLE_ELIMINATION)
  /// Como se armaron las parejas. No cambia la logica: solo decide si la
  /// pagina dice "sorteadas" o "definidas por el organizador".
  pairingMode        PairingMode      @default(DRAW)
  groupsCount        Int? // cantidad de zonas, solo si format = GROUPS_KO
  qualifiersPerGroup Int? // cuantas parejas clasifican por zona
  registrationFee    Decimal?         @db.Decimal(10, 2) // lo que pone cada jugador
  courtCost          Decimal?         @db.Decimal(10, 2) // costo total de canchas

  /// Fecha en la que arranca el torneo. Es opcional: si esta cargada, el
  /// anuncio de la home muestra la cuenta regresiva.
  startsAt         DateTime?
  /// Mientras este en true (y el torneo en SETUP) cualquiera puede anotarse
  /// solo desde la web. El administrador la abre y la cierra a mano.
  registrationOpen Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  players Player[] @relation("TournamentPlayers")
  pairs   Pair[]
  groups  Group[]
  matches Match[]
}

/// Jugador global del club: vive fuera de los torneos y se reutiliza en todos.
/// Se anota a cada torneo a traves de la relacion muchos-a-muchos `tournaments`.
model Player {
  id String @id @default(cuid())

  /// Nombre para mostrar, tal cual lo escribio quien lo cargo.
  name    String
  /// Nombre normalizado (minusculas, sin acentos, sin espacios de mas). NO es
  /// unico: dos personas distintas pueden llamarse igual y se diferencian por
  /// el DNI. Sirve para detectar posibles duplicados, no para identificar.
  nameKey String
  /// Identidad real de la persona. Sigue siendo opcional porque los jugadores
  /// cargados antes de la auto-inscripcion no lo tienen: se completa cuando el
  /// jugador se anota solo y el administrador fusiona los duplicados.
  dni     String? @unique

  tournaments Tournament[] @relation("TournamentPlayers")

  pairsAsPlayer1 Pair[] @relation("PairPlayer1")
  pairsAsPlayer2 Pair[] @relation("PairPlayer2")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nameKey])
}

model Group {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  name  String // "Zona A", "Zona B", ...
  index Int // 0-based, para ordenar y armar el nombre

  /// Clasificados propios de esta zona. null usa el numero general del torneo.
  /// Sirve cuando las zonas quedan de distinto tamano y de una tiene que pasar
  /// una cantidad distinta.
  qualifiers    Int?
  /// Orden manual de las parejas que el organizador definio para desempatar.
  /// Solo se aplica entre parejas que quedaron empatadas en partidos ganados y
  /// en la mini-liga entre ellas: nunca puede pasar por encima de un resultado.
  tiebreakOrder String[] @default([])

  pairs   Pair[]
  matches Match[]

  createdAt DateTime @default(now())

  @@unique([tournamentId, index])
}

model Pair {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Un jugador puede estar en una sola pareja por torneo, pero se repite de
  // torneo en torneo: por eso la unicidad es por (torneo, jugador).
  player1Id String
  player1   Player @relation("PairPlayer1", fields: [player1Id], references: [id])
  player2Id String
  player2   Player @relation("PairPlayer2", fields: [player2Id], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  matchesAsA Match[] @relation("MatchPairA")
  matchesAsB Match[] @relation("MatchPairB")
  matchesWon Match[] @relation("MatchWinner")

  createdAt DateTime @default(now())

  @@unique([tournamentId, player1Id])
  @@unique([tournamentId, player2Id])
}

model Match {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  // Si groupId esta seteado, es un partido de fase de grupos (round = 0, slot
  // incremental global). Si es null, es un partido de cuadro de eliminacion
  // (round = 1 es la primera ronda, slot unico dentro de la ronda).
  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  round Int
  slot  Int

  pairAId String?
  pairA   Pair?   @relation("MatchPairA", fields: [pairAId], references: [id])
  pairBId String?
  pairB   Pair?   @relation("MatchPairB", fields: [pairBId], references: [id])

  winnerId String?
  winner   Pair?   @relation("MatchWinner", fields: [winnerId], references: [id])

  createdAt DateTime @default(now())

  @@unique([tournamentId, round, slot])
}
